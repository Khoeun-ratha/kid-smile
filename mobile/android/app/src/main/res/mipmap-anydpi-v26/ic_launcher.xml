<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8+ masks launcher icons to the device's shape (circle, squircle,
     ...). The foreground is the full artwork with the sun kept inside the
     centre safe zone; the background colour only shows if a launcher insets it. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
